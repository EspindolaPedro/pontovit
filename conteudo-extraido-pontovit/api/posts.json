-json\/wp\/v2\/users\/10"}],"replies":[{"embeddable":true,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/comments?post=4818"}]}}],"wp:term":[[{"id":36,"link":"https:\/\/www.pontovit.com.br\/category\/ponto-eletronico","name":"Ponto Eletr\u00f4nico","slug":"ponto-eletronico","taxonomy":"category","_links":{"self":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/categories\/36","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/categories"}],"about":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/taxonomies\/category"}],"wp:post_type":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/posts?categories=36"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}],[]]}},{"id":371,"date":"2014-09-29T21:02:44","date_gmt":"2014-09-29T21:02:44","guid":{"rendered":"http:\/\/www.startuplywp.com\/demo\/?p=371"},"modified":"2024-12-11T15:52:22","modified_gmt":"2024-12-11T18:52:22","slug":"escala-facil","status":"publish","type":"post","link":"https:\/\/www.pontovit.com.br\/escala-facil.htm","title":{"rendered":"Escala F\u00e1cil"},"content":{"rendered":"<p>Quando falamos em organiza\u00e7\u00e3o e administra\u00e7\u00e3o de hor\u00e1rios dentro de uma empresa, sabemos que estamos falando de um assunto muito delicado, que em muitos casos pode se tornar um grande problema, n\u00e3o s\u00f3 para o colaborar, mas tamb\u00e9m para o propriet\u00e1rio da empresa. A elabora\u00e7\u00e3o de <a href=\"http:\/\/www.pontovit.com.br\/escalas-de-trabalho\/\">escalas de trabalho<\/a> pode ser muito dif\u00edcil, dependendo do n\u00famero de funcion\u00e1rios que h\u00e1.<\/p>\n<p>O Ponto Vit pode trazer pra dentro da sua empresa uma maneira mais simples de trabalhar com a escala de trabalho, voc\u00ea n\u00e3o precisa utilizar planilhas para fazer a administra\u00e7\u00e3o dos hor\u00e1rios dos seus colaboradores, nem ficar horas tentando elaborar a escalada de trabalho, monte sua escala f\u00e1cil, de maneira r\u00e1pida e simples com o sistema eletr\u00f4nico, realizando o cadastro por setor, com a quantidade de horas do seu colaborador, facilitando a maneira de trabalhar, economizando tempo e tornando o trabalho muito mais simples.<\/p>\n<p>Voc\u00ea pode utilizar o sistema de v\u00e1rias maneiras, as escalas de trabalho variam, elas n\u00e3o s\u00e3o padr\u00e3o, esse tempo varia e nosso sistema trabalha em todos eles: <a href=\"http:\/\/www.pontovit.com.br\/escala-de-trabalho-12x36\/\">escala de trabalho 12x36<\/a>, <a href=\"http:\/\/www.pontovit.com.br\/escala-de-trabalho-5x1\/\">escala 5x1<\/a>, <a href=\"http:\/\/www.pontovit.com.br\/escala-de-trabalho-5x2\/\">escala 5x2<\/a>, <a href=\"http:\/\/www.pontovit.com.br\/escala-de-trabalho-6x1\/\">escala 6x1<\/a>.<\/p>\n<p>Diante de diversos modelos de escalas de folga, o Ponto Vit tem como objetivo viabilizar e simplificar o seu trabalho e o de sua equipe, por isso oferece a vantagem de montar e controlar suas escalas de trabalho de forma f\u00e1cil e r\u00e1pida, concentrando todas as informa\u00e7\u00f5es necess\u00e1rias para o desenvolvimento, an\u00e1lise e conclus\u00e3o de relat\u00f3rios mensais para fechamento de m\u00eas, bem como contagem de horas e verifica\u00e7\u00e3o de eventual hora extra realizada por seus colaboradores.<\/p>\n","protected":false},"excerpt":{"rendered":"<p>Quando falamos em organiza\u00e7\u00e3o e administra\u00e7\u00e3o de hor\u00e1rios dentro de uma empresa, sabemos que estamos falando de um assunto muito delicado, que em muitos casos pode se tornar um grande problema, n\u00e3o s\u00f3 para o colaborar, mas tamb\u00e9m para o propriet\u00e1rio da empresa. A elabora\u00e7\u00e3o de escalas de trabalho pode ser muito dif\u00edcil, dependendo do [&hellip;]<\/p>\n","protected":false},"author":10,"featured_media":0,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"inline_featured_image":false,"footnotes":""},"categories":[32],"tags":[],"class_list":["post-371","post","type-post","status-publish","format-standard","hentry","category-escalas-de-trabalho"],"_links":{"self":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/posts\/371","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/users\/10"}],"replies":[{"embeddable":true,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/comments?post=371"}],"version-history":[{"count":1,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/posts\/371\/revisions"}],"predecessor-version":[{"id":5579,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/posts\/371\/revisions\/5579"}],"wp:attachment":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/media?parent=371"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/categories?post=371"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/tags?post=371"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]},"_embedded":{"author":[{"id":10,"name":"Pedro_Paulo Paulo","url":"http:\/\/www.pontovit.com.br","description":"","link":"https:\/\/www.pontovit.com.br\/author\/pedro-paulo","slug":"pedro-paulo","avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/a0444782a9342ee53f5855903aff561aeb00a0ee77b9eb2e1bb9d50e0cc2a1a1?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/a0444782a9342ee53f5855903aff561aeb00a0ee77b9eb2e1bb9d50e0cc2a1a1?s=48&d=mm&r=g","96":"https:\/\/secure.gravatar.com\/avatar\/a0444782a9342ee53f5855903aff561aeb00a0ee77b9eb2e1bb9d50e0cc2a1a1?s=96&d=mm&r=g"},"_links":{"self":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/users\/10","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/users"}]}}],"wp:term":[[{"id":32,"link":"https:\/\/www.pontovit.com.br\/category\/escalas-de-trabalho","name":"Escalas de trabalho","slug":"escalas-de-trabalho","taxonomy":"category","_links":{"self":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/categories\/32","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/categories"}],"about":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/taxonomies\/category"}],"wp:post_type":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/posts?categories=32"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}],[]]}},{"id":366,"date":"2014-09-29T20:11:42","date_gmt":"2014-09-29T23:11:42","guid":{"rendered":"http:\/\/www.startuplywp.com\/demo\/?p=366"},"modified":"2024-12-11T15:11:46","modified_gmt":"2024-12-11T18:11:46","slug":"escala-periodica-de-trabalho","status":"publish","type":"post","link":"https:\/\/www.pontovit.com.br\/escala-periodica-de-trabalho.htm","title":{"rendered":"Escala Peri\u00f3dica de Trabalho"},"content":{"rendered":"<p>Pesadelo para alguns funcion\u00e1rios e solu\u00e7\u00e3o para a maioria dos empres\u00e1rios, a batida de ponto \u00e9 uma maneira de <strong>organizar e controlar o hor\u00e1rio em que os funcion\u00e1rios est\u00e3o na empresa<\/strong>. Em um primeiro momento, indica-se que o empres\u00e1rio re\u00fana-se com suas equipes e explique sobre a inten\u00e7\u00e3o da instala\u00e7\u00e3o do sistema de ponto, e tamb\u00e9m aproveite esse momento para informar sobre as regras de funcionamento do sistema.<\/p>\n<p>\u00c9 comum as empresas usarem sistemas que fazem a <strong>escala de trabalho autom\u00e1tica<\/strong> e imprimirem a escala peri\u00f3dica de trabalho para colar no mural onde os funcion\u00e1rios possam tirar eventual d\u00favida ou tamb\u00e9m, por exemplo, alguns funcion\u00e1rios vez ou outra, podem se esquecer de bater o ponto, na hora da entrada, sa\u00edda, ou intervalo de almo\u00e7o. Para esses casos, \u00e9 necess\u00e1rio estabelecer um limite de esquecimento, assim, o funcion\u00e1rio ir\u00e1 ser for\u00e7ado a lembrar para si pr\u00f3prio e para seus colegas sobre a import\u00e2ncia de sempre se lembrar da import\u00e2ncia de bater o ponto. A regra para o que o funcion\u00e1rio dever\u00e1 fazer nesse caso, dever\u00e1 ser estabelecida j\u00e1 no inicio da utiliza\u00e7\u00e3o do sistema de pontos, para que n\u00e3o reste nenhuma d\u00favida por parte dos colaboradores.<\/p>\n<p>&nbsp;<\/p>\n<p>A emiss\u00e3o de comprovante para o colaborador \u00e9 tamb\u00e9m essencial para que o pr\u00f3prio funcion\u00e1rio consiga ter sua organiza\u00e7\u00e3o em rela\u00e7\u00e3o \u00e0s horas trabalhadas por ele na empresa, bem como uma vantagem para que ele assuma o sistema de pontos em sua rotina. Dessa maneira, horas extras ser\u00e3o calculadas e depois, organizadas em forma de pagamento extra ou banco de horas, de acordo com o que for combinado entre a empresa e os funcion\u00e1rios.<\/p>\n<p>\u00c9 importante salientar que a \u00fanica inten\u00e7\u00e3o da empresa quanto ao controle de horas do colaborador e a impress\u00e3o da escala peri\u00f3dica de trabalho, \u00e9 em rela\u00e7\u00e3o \u00e0s horas trabalhadas, ficando proibido assim, pela portaria que regulamenta a utiliza\u00e7\u00e3o do sistema de pontos pelas empresas, o controle da hora em que o colaborador esteve ou n\u00e3o na organiza\u00e7\u00e3o. As devidas restri\u00e7\u00f5es em rela\u00e7\u00e3o ao acesso limitado do funcion\u00e1rio ao local de trabalho dever\u00e3o ser regulamentadas via contrato de trabalho, ainda no momento de contrata\u00e7\u00e3o.<\/p>\n<p>O ato de bater o ponto poder\u00e1 ser feito somente quando o funcion\u00e1rio de fato estiver na empresa, ou seja, fica proibido pela portaria regulamentadora, o batimento de ponto \u00e0 dist\u00e2ncia (remoto). Sendo assim, \u00e9 importante que os empres\u00e1rios e respons\u00e1veis pelos hor\u00e1rios dos funcion\u00e1rios fiquem atentos \u00e0s regras e mantenham uma comunica\u00e7\u00e3o clara e aberta com seus colaboradores.<\/p>\n","protected":false},"excerpt":{"rendered":"<p>Pesadelo para alguns funcion\u00e1rios e solu\u00e7\u00e3o para a maioria dos empres\u00e1rios, a batida de ponto \u00e9 uma maneira de organizar e controlar o hor\u00e1rio em que os funcion\u00e1rios est\u00e3o na empresa. Em um primeiro momento, indica-se que o empres\u00e1rio re\u00fana-se com suas equipes e explique sobre a inten\u00e7\u00e3o da instala\u00e7\u00e3o do sistema de ponto, e [&hellip;]<\/p>\n","protected":false},"author":10,"featured_media":4616,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"inline_featured_image":false,"footnotes":""},"categories":[32],"tags":[],"class_list":["post-366","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-escalas-de-trabalho"],"_links":{"self":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/posts\/366","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/users\/10"}],"replies":[{"embeddable":true,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/comments?post=366"}],"version-history":[{"count":4,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/posts\/366\/revisions"}],"predecessor-version":[{"id":5567,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/posts\/366\/revisions\/5567"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/media\/4616"}],"wp:attachment":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/media?parent=366"}],"wp:term":[{"taxonomy":"category","em