"file":"2025\/07\/1.jpg","filesize":92954,"sizes":{"medium":{"file":"1-300x200.jpg","width":300,"height":200,"filesize":13260,"mime_type":"image\/jpeg","source_url":"https:\/\/www.pontovit.com.br\/wp-content\/uploads\/2025\/07\/1-300x200.jpg"},"thumbnail":{"file":"1-150x150.jpg","width":150,"height":150,"filesize":6253,"mime_type":"image\/jpeg","source_url":"https:\/\/www.pontovit.com.br\/wp-content\/uploads\/2025\/07\/1-150x150.jpg"},"medium_large":{"file":"1-768x513.jpg","width":768,"height":513,"filesize":50192,"mime_type":"image\/jpeg","source_url":"https:\/\/www.pontovit.com.br\/wp-content\/uploads\/2025\/07\/1-768x513.jpg"},"full":{"file":"1.jpg","width":1000,"height":668,"mime_type":"image\/jpeg","source_url":"https:\/\/www.pontovit.com.br\/wp-content\/uploads\/2025\/07\/1.jpg"}},"image_meta":{"aperture":"0","credit":"","camera":"","caption":"","created_timestamp":"0","copyright":"","focal_length":"0","iso":"0","shutter_speed":"0","title":"","orientation":"1","keywords":[]}},"source_url":"https:\/\/www.pontovit.com.br\/wp-content\/uploads\/2025\/07\/1.jpg","_links":{"self":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/media\/5975","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/media"}],"about":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/types\/attachment"}],"author":[{"embeddable":true,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/users\/10"}],"replies":[{"embeddable":true,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/comments?post=5975"}],"wp:attached-to":[{"embeddable":true,"post_type":"post","id":5974,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/posts\/5974"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}],"wp:term":[[{"id":32,"link":"https:\/\/www.pontovit.com.br\/category\/escalas-de-trabalho","name":"Escalas de trabalho","slug":"escalas-de-trabalho","taxonomy":"category","_links":{"self":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/categories\/32","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/categories"}],"about":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/taxonomies\/category"}],"wp:post_type":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/posts?categories=32"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":34,"link":"https:\/\/www.pontovit.com.br\/category\/leis-trabalhistas","name":"Leis Trabalhistas","slug":"leis-trabalhistas","taxonomy":"category","_links":{"self":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/categories\/34","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/categories"}],"about":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/taxonomies\/category"}],"wp:post_type":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/posts?categories=34"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}],[]]}},{"id":5960,"date":"2025-06-10T10:42:24","date_gmt":"2025-06-10T13:42:24","guid":{"rendered":"https:\/\/www.pontovit.com.br\/?p=5960"},"modified":"2025-06-10T10:42:26","modified_gmt":"2025-06-10T13:42:26","slug":"trabalho-em-feriados-tera-nova-regra-a-partir-de-julho-veja-o-que-muda","status":"publish","type":"post","link":"https:\/\/www.pontovit.com.br\/trabalho-em-feriados-tera-nova-regra-a-partir-de-julho-veja-o-que-muda.htm","title":{"rendered":"Trabalho em feriados ter\u00e1 nova regra \u00e0 partir de Julho: veja o que muda"},"content":{"rendered":"\n<h2 class=\"wp-block-heading\"><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Com as constantes mudan\u00e7as na legisla\u00e7\u00e3o trabalhista, manter-se atualizado deixou de ser apenas uma boa pr\u00e1tica para se tornar uma necessidade. A partir de <strong>1\u00ba de julho de 2025<\/strong>, entra em vigor uma <strong>nova regra sobre o trabalho em feriados<\/strong>, que impactar\u00e1 diretamente empresas de diversos setores, especialmente o com\u00e9rcio. Nesse cen\u00e1rio de transforma\u00e7\u00f5es, contar com sistemas de gest\u00e3o confi\u00e1veis, como o da <strong>PontoVit<\/strong>, \u00e9 fundamental para garantir conformidade e organiza\u00e7\u00e3o na jornada de trabalho dos colaboradores.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n\n\n\n<h2 class=\"wp-block-heading\">O que muda a partir de julho?<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">De acordo com a <strong>Lei n\u00ba 14.923\/2024<\/strong>, sancionada em mar\u00e7o e v\u00e1lida a partir de julho, o trabalho em <strong>feriados<\/strong> s\u00f3 poder\u00e1 ocorrer mediante <strong>acordo coletivo firmado entre empresas e sindicatos da categoria<\/strong>. Ou seja, a autoriza\u00e7\u00e3o gen\u00e9rica que antes permitia o trabalho em feriados com base em normas infralegais (como portarias do Minist\u00e9rio do Trabalho) deixa de ser v\u00e1lida.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Na pr\u00e1tica, isso significa que, <strong>mesmo em setores tradicionalmente autorizados a funcionar em feriados<\/strong>, como com\u00e9rcio e servi\u00e7os, o trabalho nesses dias depender\u00e1 de negocia\u00e7\u00e3o e formaliza\u00e7\u00e3o com o sindicato. A nova regra altera diretamente o que previa a antiga <strong>Portaria 671\/2021<\/strong>, que permitia essa autoriza\u00e7\u00e3o por meio de normativas do poder p\u00fablico.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n\n\n\n<h2 class=\"wp-block-heading\">Por que essa mudan\u00e7a \u00e9 importante?<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">A proposta da nova lei \u00e9 refor\u00e7ar o <strong>papel dos sindicatos nas negocia\u00e7\u00f5es trabalhistas<\/strong>, fortalecendo o di\u00e1logo coletivo entre empregadores e trabalhadores. Al\u00e9m disso, busca garantir melhores condi\u00e7\u00f5es de trabalho e evitar jornadas excessivas, sobretudo em datas que, tradicionalmente, deveriam ser de descanso.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Essa altera\u00e7\u00e3o traz implica\u00e7\u00f5es pr\u00e1ticas importantes para as empresas. O n\u00e3o cumprimento da nova exig\u00eancia pode resultar em <strong>a\u00e7\u00f5es trabalhistas, multas e passivos legais<\/strong>, caso os colaboradores sejam convocados a trabalhar em feriados sem o respaldo de um acordo coletivo v\u00e1lido.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n\n\n\n<h2 class=\"wp-block-heading\">Como a empresa deve se preparar?<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Para adaptar-se \u00e0 nova regra, \u00e9 fundamental que os gestores tomem algumas medidas imediatas:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>Revisar os contratos e escalas de trabalho<\/strong>, principalmente nos setores que atuam em feriados com frequ\u00eancia;<\/li>\n\n\n\n<li><strong>Entrar em contato com os sindicatos da categoria<\/strong> para verificar a exist\u00eancia de acordos coletivos ou dar in\u00edcio a negocia\u00e7\u00f5es;<\/li>\n\n\n\n<li><strong>Documentar todas as tratativas formalmente<\/strong>, garantindo respaldo jur\u00eddico;<\/li>\n\n\n\n<li><strong>Planejar as escalas de forma transparente e organizada<\/strong>, assegurando que os colaboradores estejam cientes e de acordo com as condi\u00e7\u00f5es estabelecidas.<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">Aqui, a <strong>PontoVit<\/strong> pode ser uma parceira estrat\u00e9gica: nosso sistema facilita o controle de jornadas, a organiza\u00e7\u00e3o de escalas em datas especiais e o acompanhamento do cumprimento das regras da CLT e dos acordos coletivos, garantindo que a opera\u00e7\u00e3o continue fluindo dentro da legalidade.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n\n\n\n<h2 class=\"wp-block-heading\">O que n\u00e3o muda?<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">A nova regra <strong>n\u00e3o altera o funcionamento em domingos<\/strong> \u2014 esse permanece poss\u00edvel desde que respeitadas as normas da CLT e os acordos coletivos que j\u00e1 existirem. Tamb\u00e9m permanecem v\u00e1lidas <strong>as escalas compensat\u00f3rias e o banco de horas<\/strong>, desde que previamente acordados entre as partes.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Para empresas que operam continuamente ou em setores essenciais, o planejamento cuidadoso e a negocia\u00e7\u00e3o transparente com os sindicatos se tornam ainda mais importantes. A organiza\u00e7\u00e3o das escalas e o registro adequado da jornada dos colaboradores ser\u00e3o diferenciais na preven\u00e7\u00e3o de riscos e no fortalecimento da cultura de conformidade.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Estar atento \u00e0s mudan\u00e7as legais \u00e9 mais do que cumprir a lei \u2014 \u00e9 demonstrar respeito e compromisso com a equipe. Com o apoio da PontoVit, sua empresa se mant\u00e9m atualizada, organizada e preparada para enfrentar qualquer mudan\u00e7a com agilidade e seguran\u00e7a. Precisa de ajuda para regularizar suas escalas e estar de acordo com as normas CLT? Entre em <strong><a href=\"https:\/\/www.pontovit.com.br\/contato\/\">contato<\/a><\/strong> conosco e descubra como podemos ajudar.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Fontes<\/strong>: UOL Economia, Campo Grande News, Migalhas, Valor Econ\u00f4mico, Valor.Globo<\/p>\n","protected":false},"excerpt":{"rendered":"<p>Com as constantes mudan\u00e7as na legisla\u00e7\u00e3o trabalhista, manter-se atualizado deixou de ser apenas uma boa pr\u00e1tica para se tornar uma necessidade. A partir de 1\u00ba de julho de 2025, entra em vigor uma nova regra sobre o trabalho em feriados, que impactar\u00e1 diretamente empresas de diversos setores, especialmente o com\u00e9rcio. Nesse cen\u00e1rio de transforma\u00e7\u00f5es, contar [&hellip;]<\/p>\n","protected":false},"author":10,"featured_media":5961,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"inline_featured_image":false,"footnotes":""},"categories":[34],"tags":[],"class_list":["post-5960","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-leis-trabalhistas"],"_links":{"self":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/posts\/5960","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/users\/10"}],"replies":[{"embeddable":true,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/comments?post=5960"}],"version-history":[{"count":1,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/posts\/5960\/revisions"}],"predecessor-version":[{"id":5962,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/posts\/5960\/revisions\/5962"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/media\/5961"}],"wp:attachment":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/media?parent=5960"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/categories?post=5960"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/tags?post=5960"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]},"_embedded":{"author":[{"id":10,"name":"Pedro_Paulo Paulo","url":"http:\/\/www.pontovit.com.br","description":"","link":"https:\/\/www.pontovit.com.br\/author\/pedro-paulo","slug":"pedro-paulo","avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/a0444782a9342ee53f5855903aff561aeb00a0ee77b9eb2e1bb9d50e0cc2a1a1?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/a0444782a9342ee53f5855903af