vit.com.br\/wp-content\/uploads\/2014\/09\/escala-periodica-de-trabalho1-150x150.png"},"full":{"file":"escala-periodica-de-trabalho1.png","width":456,"height":216,"mime_type":"image\/png","source_url":"https:\/\/www.pontovit.com.br\/wp-content\/uploads\/2014\/09\/escala-periodica-de-trabalho1.png"}},"image_meta":{"aperture":"0","credit":"","camera":"","caption":"","created_timestamp":"0","copyright":"","focal_length":"0","iso":"0","shutter_speed":"0","title":"","orientation":"0","keywords":[]}},"source_url":"https:\/\/www.pontovit.com.br\/wp-content\/uploads\/2014\/09\/escala-periodica-de-trabalho1.png","_links":{"self":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/media\/4616","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/media"}],"about":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/types\/attachment"}],"author":[{"embeddable":true,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/users\/10"}],"replies":[{"embeddable":true,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/comments?post=4616"}],"wp:attached-to":[{"embeddable":true,"post_type":"post","id":366,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/posts\/366"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}],"wp:term":[[{"id":32,"link":"https:\/\/www.pontovit.com.br\/category\/escalas-de-trabalho","name":"Escalas de trabalho","slug":"escalas-de-trabalho","taxonomy":"category","_links":{"self":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/categories\/32","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/categories"}],"about":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/taxonomies\/category"}],"wp:post_type":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/posts?categories=32"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}],[]]}},{"id":1289,"date":"2014-09-26T11:28:02","date_gmt":"2014-09-26T14:28:02","guid":{"rendered":"http:\/\/www.startuplywp.com\/demo\/?p=233"},"modified":"2024-12-11T15:52:50","modified_gmt":"2024-12-11T18:52:50","slug":"controle-de-escalas-de-trabalho","status":"publish","type":"post","link":"https:\/\/www.pontovit.com.br\/controle-de-escalas-de-trabalho.htm","title":{"rendered":"Controle de Escalas de Trabalho"},"content":{"rendered":"<p>Uma das coisas que mais gera pol\u00eamicas em um condom\u00ednio hoje em dia \u00e9 o controle de escalas de trabalho na portaria, a impress\u00e3o que temos \u00e9 que eles saem de l\u00e1 justamente quando estamos chegando. A melhor maneira de resolver isso \u00e9 com uma escala de trabalho bem elaborada, nesse caso uma das mais comum a ser usada \u00e9 a <a href=\"http:\/\/www.pontovit.com.br\/escala-de-trabalho-5x1\/\">escala 5x1<\/a>, onde o empregado trabalha 5 dias corridos e descansa 1, temos outras op\u00e7\u00f5es, como a <a href=\"http:\/\/www.pontovit.com.br\/escala-de-trabalho-5x2\/\">escala 5x2<\/a>, 6x2, 6x1 e 7x2 ou at\u00e9 escalas de 12x36 horas, como as usadas em farm\u00e1cias.<\/p>\n<h3>Como \u00e9 feito o controle de escalas de trabalho<\/h3>\n<p>O uso dessas escalas ajudam muito a organizar a sua empresa e ter mais controle sobre o que est\u00e1 acontecendo, mas n\u00e3o adianta tentar fazer isso de qualquer maneira, isso pode acabar te atrapalhando e fazer voc\u00ea perder o controle das escalas dos seus funcion\u00e1rios, e tamb\u00e9m n\u00e3o cumprindo as nas normas da CLT.<\/p>\n<p>Devido as leis trabalhistas, n\u00e3o \u00e9 aconselh\u00e1vel utilizar tabelas de Excel e modelos prontos para controle de escalas de trabalho. O Ponto Vit oferece um sistema que trabalha dentro do modelo da CLT, ajudando o gestor e proporcionando ao empregado melhores condi\u00e7\u00f5es de trabalho, o sistema produz documenta\u00e7\u00e3o leg\u00edtima com relat\u00f3rios e produ\u00e7\u00e3o de provas, controla o excedente de horas extras, prevenindo multas e processos trabalhistas.<\/p>\n","protected":false},"excerpt":{"rendered":"<p>Uma das coisas que mais gera pol\u00eamicas em um condom\u00ednio hoje em dia \u00e9 o controle de escalas de trabalho na portaria, a impress\u00e3o que temos \u00e9 que eles saem de l\u00e1 justamente quando estamos chegando. A melhor maneira de resolver isso \u00e9 com uma escala de trabalho bem elaborada, nesse caso uma das mais [&hellip;]<\/p>\n","protected":false},"author":10,"featured_media":4620,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"inline_featured_image":false,"footnotes":""},"categories":[32],"tags":[],"class_list":["post-1289","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-escalas-de-trabalho"],"_links":{"self":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/posts\/1289","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/users\/10"}],"replies":[{"embeddable":true,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/comments?post=1289"}],"version-history":[{"count":4,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/posts\/1289\/revisions"}],"predecessor-version":[{"id":5580,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/posts\/1289\/revisions\/5580"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/media\/4620"}],"wp:attachment":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/media?parent=1289"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/categories?post=1289"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/tags?post=1289"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]},"_embedded":{"author":[{"id":10,"name":"Pedro_Paulo Paulo","url":"http:\/\/www.pontovit.com.br","description":"","link":"https:\/\/www.pontovit.com.br\/author\/pedro-paulo","slug":"pedro-paulo","avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/a0444782a9342ee53f5855903aff561aeb00a0ee77b9eb2e1bb9d50e0cc2a1a1?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/a0444782a9342ee53f5855903aff561aeb00a0ee77b9eb2e1bb9d50e0cc2a1a1?s=48&d=mm&r=g","96":"https:\/\/secure.gravatar.com\/avatar\/a0444782a9342ee53f5855903aff561aeb00a0ee77b9eb2e1bb9d50e0cc2a1a1?s=96&d=mm&r=g"},"_links":{"self":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/users\/10","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/users"}]}}],"wp:featuredmedia":[{"id":4620,"date":"2016-08-17T16:31:14","slug":"controle-de-escalas-de-trabalho-2","type":"attachment","link":"https:\/\/www.pontovit.com.br\/controle-de-escalas-de-trabalho-2","title":{"rendered":"controle-de-escalas-de-trabalho"},"author":10,"featured_media":0,"caption":{"rendered":""},"alt_text":"","media_type":"image","mime_type":"image\/jpeg","media_details":{"width":320,"height":186,"file":"2014\/09\/controle-de-escalas-de-trabalho.jpg","filesize":14201,"sizes":{"medium":{"file":"controle-de-escalas-de-trabalho-300x174.jpg","width":300,"height":174,"filesize":14287,"mime_type":"image\/jpeg","source_url":"https:\/\/www.pontovit.com.br\/wp-content\/uploads\/2014\/09\/controle-de-escalas-de-trabalho-300x174.jpg"},"thumbnail":{"file":"controle-de-escalas-de-trabalho-150x150.jpg","width":150,"height":150,"filesize":6680,"mime_type":"image\/jpeg","source_url":"https:\/\/www.pontovit.com.br\/wp-content\/uploads\/2014\/09\/controle-de-escalas-de-trabalho-150x150.jpg"},"full":{"file":"controle-de-escalas-de-trabalho.jpg","width":320,"height":186,"mime_type":"image\/jpeg","source_url":"https:\/\/www.pontovit.com.br\/wp-content\/uploads\/2014\/09\/controle-de-escalas-de-trabalho.jpg"}},"image_meta":{"aperture":"0","credit":"","camera":"","caption":"","created_timestamp":"0","copyright":"","focal_length":"0","iso":"0","shutter_speed":"0","title":"","orientation":"0","keywords":[]}},"source_url":"https:\/\/www.pontovit.com.br\/wp-content\/uploads\/2014\/09\/controle-de-escalas-de-trabalho.jpg","_links":{"self":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/media\/4620","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/media"}],"about":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/types\/attachment"}],"author":[{"embeddable":true,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/users\/10"}],"replies":[{"embeddable":true,"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/comments?post=4620"}]}}],"wp:term":[[{"id":32,"link":"https:\/\/www.pontovit.com.br\/category\/escalas-de-trabalho","name":"Escalas de trabalho","slug":"escalas-de-trabalho","taxonomy":"category","_links":{"self":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/categories\/32","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/categories"}],"about":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/taxonomies\/category"}],"wp:post_type":[{"href":"https:\/\/www.pontovit.com.br\/wp-json\/wp\/v2\/posts?categories=32"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}],[]]}},{"id":350,"date":"2014-03-20T22:22:42","date_gmt":"2014-03-21T01:22:42","guid":{"rendered":"http:\/\/www.pontovit.com.br\/?p=350"},"modified":"2023-10-03T15:55:40","modified_gmt":"2023-10-03T18:55:40","slug":"escala-de-funcionarios","status":"publish","type":"post","link":"https:\/\/www.pontovit.com.br\/escala-de-funcionarios.htm","title":{"rendered":"Escala de Funcion\u00e1rios"},"content":{"rendered":"<p>Mesmo que cada institui\u00e7\u00e3o tenha as suas regras de escala de trabalho diferenciadas, <strong>todas elas devem ser baseadas em regras e normas intituladas pela CLT<\/strong> (Consolida\u00e7\u00e3o das Leis do Trabalho). Entre elas, podemos destacar algumas das regras b\u00e1sicas que devem ser seguidas pelos empregados e empregadores.<\/p>\n<ul>\n<li>Primeiramente, destaca-se que o tempo m\u00e1ximo de uma jornada trabalhista \u00e9 de 12 horas, ou seja, qualquer trabalho que ultrapasse esse tempo de jornada di\u00e1ria age contra as leis.<\/li>\n<li>Al\u00e9m disso, em caso de jornadas de trabalho de 12 horas, o trabalhador tem direito a um per\u00edodo de folga de 36 horas ininterruptas. Esse tipo de escala de trabalho \u00e9 muito comum em hospitais, principalmente em plant\u00f5es. Ent\u00e3o, o m\u00e9dico\/enfermeira ou outro profissional atua por 12 horas e, depois, dever\u00e1 ter 36 horas de descanso.<\/li>\n<li>Em jornadas de trabalhos mais leves, ou seja, as de quatro e seis horas (geralmente est\u00e1gios), a obrigatoriedade \u00e9 de que sejam oferecidos, no m\u00ednimo, 15 minutos de descanso para o funcion\u00e1rio, ou seja, um intervalo para que se alimente ou realize outra atividade.<\/li>\n<li>Para todas as jornadas que ultrapassem seis horas di\u00e1rias, o intervalo m\u00ednimo para lanche \u00e9 de uma hora.<\/li>\n<\/ul>\n<p>O <a href=\"http:\/\/www.pontovit.com.br\/escalas-de-trabalho\">m\u00f3dulo de escalas de trabalho<\/a> do PontoVit vem com a proposta de estruturar sua gest\u00e3o nas jornadas de trabalho com ferramentas pr\u00e1ticas e precisas, 100% adequadas a CLT. Planejamento de horas trabalhadas, livre de excedentes, fa\u00e7a uma demonstra\u00e7\u00e3o.<\/p>\n","protected":false},"excerpt":{"rendered":"<p>Mesmo que cada institui\u00e7\u00e3o tenha as suas regras de escala de trabalho diferenciadas, todas elas devem ser baseadas em regras e normas intituladas pela CLT (Consolida\u00e7\u00e3o das Leis do Trabalho). Entre elas, podemos destacar algumas das regras b\u00e1sicas 